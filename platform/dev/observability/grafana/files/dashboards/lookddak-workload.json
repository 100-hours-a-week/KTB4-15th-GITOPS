{
  "uid": "lookddak-workload",
  "title": "LookDDak / 워크로드",
  "tags": [
    "lookddak"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info{namespace=~\"lookddak-.*\"}, namespace)",
          "refId": "V"
        },
        "definition": "label_values(kube_pod_info{namespace=~\"lookddak-.*\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "workload",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_labels{namespace=~\"$namespace\"}, label_app_kubernetes_io_name)",
          "refId": "V"
        },
        "definition": "label_values(kube_pod_labels{namespace=~\"$namespace\"}, label_app_kubernetes_io_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
