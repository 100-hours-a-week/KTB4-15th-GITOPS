        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kube_pod_status_phase{phase=\"Running\",namespace=~\"$namespace\", pod=~\"($workload)-.*\"}==1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
