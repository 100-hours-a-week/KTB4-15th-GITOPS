    },
    "query": "label_values({source=\"pod\"}, namespace)",
    "definition": "label_values({source=\"pod\"}, namespace)",
    "regex": "lookddak-.*",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": "lookddak-.*",
